MITRA_INSTANCE_ID=default
# Optional: MITRA_HOME=/absolute/path/to/mitra-data
# Never commit real credentials. OAuth integrations are separate opt-in adapters.

# Optional OpenAI-compatible provider; never put a real secret in this file.
# MITRA_MODEL_BASE_URL=https://api.example.com/v1
# MITRA_MODEL_NAME=your-model-name
# MITRA_MODEL_API_KEY_ENV=MITRA_MODEL_API_KEY

# Multi-provider routing (metadata only; API secrets stay in the environment).
# Each provider requires id, base_url, model and api_key_env.
# MITRA_MODEL_PROVIDERS=[{"id":"local","base_url":"http://127.0.0.1:11434/v1","model":"local-model","api_key_env":"LOCAL_MODEL_KEY"},{"id":"cloud","base_url":"https://api.example.com/v1","model":"cloud-model","api_key_env":"CLOUD_MODEL_KEY"}]
# MITRA_MODEL_DEFAULT=local
# MITRA_MODEL_ROUTES={"planning":["local","cloud"],"coding":["cloud","local"]}

# Optional custom OAuth provider hosts; built-in Google OAuth hosts are allowlisted.
# MITRA_OAUTH_ALLOWED_HOSTS=auth.example.com,token.example.com
